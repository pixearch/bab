generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
  CANCELLED
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
  SETTLED
}

enum LedgerTransactionType {
  DEPOSIT
  WITHDRAWAL
  WAGER
  PAYOUT
  REFUND
  ADJUSTMENT
}

model Tenant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  stripeAccountId String?      @unique
  status          TenantStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  markets Market[]
  users   User[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  externalAuthId String
  balance        Decimal  @default(0.0000) @db.Decimal(12, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  ledgerEntries LedgerEntry[]
  orders        Order[]

  @@unique([tenantId, externalAuthId])
  @@index([tenantId])
}

model Market {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  question   String
  status     MarketStatus @default(OPEN)
  closeTime  DateTime
  resolution String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  outcomes Outcome[]
  orders   Order[]

  @@index([tenantId])
  @@index([status])
  @@index([closeTime])
}

model Outcome {
  id          String   @id @default(uuid()) @db.Uuid
  marketId    String   @db.Uuid
  name        String
  currentOdds Decimal  @db.Decimal(8, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  market Market  @relation(fields: [marketId], references: [id])
  orders Order[]

  @@index([marketId])
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  marketId        String      @db.Uuid
  outcomeId       String      @db.Uuid
  amountWagered   Decimal     @db.Decimal(12, 4)
  payoutPotential Decimal     @db.Decimal(12, 4)
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  market  Market  @relation(fields: [marketId], references: [id])
  outcome Outcome @relation(fields: [outcomeId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([outcomeId])
  @@index([status])
}

model LedgerEntry {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @db.Uuid
  amount          Decimal               @db.Decimal(12, 4)
  transactionType LedgerTransactionType
  referenceId     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([referenceId])
}
